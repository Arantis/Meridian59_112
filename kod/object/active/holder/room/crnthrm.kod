////////////////////////////////////////////////////////////////////////////////
CorNothRoom is Room

constants:

   include blakston.khd

classvars:

   viWeatherZone = WEATHER_ZONE_CORNOTH
   viWeatherMask = WEATHER_MASK_DEFAULT_NS
   viRegion = REGION_CORNOTH

messages:

   NewHoldObject(what = $, new_pos = $)
   {
      if IsClass(what, &User)
      {
         Send(what, @AwardAchievement,
              #achievement_id=ACHIEVE_VISIT_CORNOTH);
      }

      propagate;
   }

end
////////////////////////////////////////////////////////////////////////////////
